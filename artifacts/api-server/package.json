{
  "name": "@workspace/api-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --local --ip 0.0.0.0 --port ${PORT:-8787} --persist-to .wrangler/state",
    "build": "PORT=4173 BASE_PATH=/ pnpm --filter @workspace/maharashtra-electrical-store run build && wrangler deploy --dry-run --outdir dist",
    "deploy": "PORT=4173 BASE_PATH=/ pnpm --filter @workspace/maharashtra-electrical-store run build && wrangler deploy",
    "start": "wrangler dev --local --ip 0.0.0.0 --port ${PORT:-8787} --persist-to .wrangler/state",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@workspace/api-zod": "workspace:*",
    "@workspace/db": "workspace:*",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "drizzle-orm": "catalog:",
    "express": "^5.2.1",
    "hono": "^4.13.13",
    "jose": "^6.2.12",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261016.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "catalog:",
    "esbuild": "0.28.2",
    "esbuild-plugin-pino": "^2.3.3",
    "pino-pretty": "^13.1.3",
    "thread-stream": "3.1.0",
    "wrangler": "^4.151.0"
  }
}
